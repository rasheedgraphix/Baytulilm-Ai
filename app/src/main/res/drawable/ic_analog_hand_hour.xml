<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Hour Hand pointing to 12 o'clock, pivot at (100, 100) -->
    <!-- Tail behind pivot -->
    <path
        android:pathData="M 98,100 L 98,114 A 2,2 0 0,0 102,114 L 102,100 Z"
        android:fillColor="#D4AF37" />

    <!-- Sleek Sword Hour Hand -->
    <path
        android:pathData="M 97,100 L 97,55 L 100,42 L 103,55 L 103,100 Z"
        android:fillColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeColor="#D4AF37" />

    <!-- Central Center Cap -->
    <path
        android:pathData="M 100,100 m -4, 0 a 4,4 0 1,0 8,0 a 4,4 0 1,0 -8,0"
        android:fillColor="#FDE047" />
</vector>
