<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Deep sunken watch calendar plate background -->
    <gradient
        android:angle="90"
        android:startColor="#050C1A"
        android:endColor="#0B162C"
        android:type="linear" />
    <!-- Beveled metallic chrome border -->
    <stroke
        android:width="1.5dp"
        android:color="#94A3B8" />
    <corners android:radius="6dp" />
    <padding
        android:left="6dp"
        android:right="6dp"
        android:top="2dp"
        android:bottom="2dp" />
</shape>
