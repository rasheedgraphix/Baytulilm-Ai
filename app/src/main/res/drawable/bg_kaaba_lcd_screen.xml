<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Deep obsidian LCD glass background -->
    <solid android:color="#000000" />
    <!-- Fine metallic gray border like genuine wall clock LCD window -->
    <stroke
        android:width="1.2dp"
        android:color="#94A3B8" />
    <corners android:radius="5dp" />
    <padding
        android:left="5dp"
        android:right="5dp"
        android:top="2dp"
        android:bottom="2dp" />
</shape>
