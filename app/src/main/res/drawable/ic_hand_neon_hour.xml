        android:pathData="M 95.5,100 L 96.5,56 L 100,48 L 103.5,56 L 104.5,100 Z"
        android:fillColor="#14B8A6"
        android:strokeWidth="1"
        android:strokeColor="#2DD4BF" />

    <!-- Center Bright Luminous Strip -->
    <path
        android:pathData="M 98,96 L 98.5,58 L 100,52 L 101.5,58 L 102,96 Z"
        android:fillColor="#99F6E4" />

    <!-- Center Pivot Base -->
    <path
        android:pathData="M 100,100 m -5, 0 a 5,5 0 1,0 10,0 a 5,5 0 1,0 -10,0"
        android:fillColor="#040608"
        android:strokeWidth="1.5"
        android:strokeColor="#2DD4BF" />
</vector>
