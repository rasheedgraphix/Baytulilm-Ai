    <path
        android:pathData="M 97,100 L 97,112 L 103,112 L 103,100 Z"
        android:fillColor="#091E1C"
        android:strokeWidth="1"
        android:strokeColor="#14B8A6" />

    <!-- Tapered Sword Body -->
