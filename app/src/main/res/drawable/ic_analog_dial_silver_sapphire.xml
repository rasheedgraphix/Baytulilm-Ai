    <path android:pathData="M 141,171 L 133,158" android:strokeWidth="2" android:strokeColor="#38BDF8"/>
    <path android:pathData="M 59,171 L 67,158" android:strokeWidth="2" android:strokeColor="#38BDF8"/>
