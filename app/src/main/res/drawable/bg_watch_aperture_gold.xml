<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Deep sunken emerald watch calendar plate background -->
    <gradient
        android:angle="90"
        android:startColor="#04120D"
        android:endColor="#082319"
        android:type="linear" />
    <!-- Beveled 24k gold border -->
    <stroke
        android:width="1.5dp"
        android:color="#D4AF37" />
    <corners android:radius="6dp" />
    <padding
        android:left="6dp"
        android:right="6dp"
        android:top="2dp"
        android:bottom="2dp" />
</shape>
