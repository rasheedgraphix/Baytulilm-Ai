<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Dark tinted acrylic LED display compartment -->
    <solid android:color="#120303" />
    <!-- Thin beveled metallic compartment border -->
    <stroke
        android:width="1dp"
        android:color="#3B1212" />
    <corners android:radius="4dp" />
    <padding
        android:left="6dp"
        android:right="6dp"
        android:top="2dp"
        android:bottom="2dp" />
</shape>
