<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Deep obsidian metallic body of the Mosque Clock -->
    <gradient
        android:angle="270"
        android:startColor="#0D1117"
        android:centerColor="#070A0E"
        android:endColor="#020406"
        android:type="linear" />
    <!-- 24K Gold / Bronze metallic architectural border -->
    <stroke
        android:width="2.5dp"
        android:color="#D4AF37" />
    <!-- Arched top dome shape -->
    <corners
        android:topLeftRadius="28dp"
        android:topRightRadius="28dp"
        android:bottomLeftRadius="14dp"
        android:bottomRightRadius="14dp" />
</shape>
