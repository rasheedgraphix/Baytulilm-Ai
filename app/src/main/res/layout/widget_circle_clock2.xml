<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_circle2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Perfectly centered 1:1 square container so it NEVER stretches into an oval -->
    <RelativeLayout
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="center">

        <!-- High-Resolution Neon Cyan Tactical Clock Face with Glowing Numerals, Sword Hands & Red Needle -->
        <ImageView
            android:id="@+id/iv_clock2_face"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dial_neon_tactical" />

        <!-- Live Digital Time inside Top Red Circle (Matching "02:49 AM" in uploaded photo) -->
        <TextClock
            android:id="@+id/tc_clock2_digital"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="56dp"
            android:format12Hour="hh:mm a"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:shadowColor="#E62DD4BF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            android:textColor="#2DD4BF"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Rectangular Date Box inside Bottom Red Circle (Matching "[ 18-AUG ]" in uploaded photo) -->
        <LinearLayout
            android:id="@+id/ll_clock2_date_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="54dp"
            android:background="@drawable/bg_neon_date_box"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1.5dp">

            <TextView
                android:id="@+id/tv_clock2_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="12-SEP"
                android:textColor="#5EEAD4"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </RelativeLayout>
</FrameLayout>
