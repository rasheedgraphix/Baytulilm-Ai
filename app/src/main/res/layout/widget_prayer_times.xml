<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_prayer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Mosque Wall Clock Card: Wraps content tightly so NO empty void appears at the bottom -->
    <LinearLayout
        android:id="@+id/ll_mosque_clock_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_mosque_wall_clock"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="8dp">

    <!-- Top Mehrab Arch Header (Dome peak with Crescent & Bismillah) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/tv_prayer_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="📍 اسلام آباد"
            android:textColor="#34D399"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Mosque Crescent & Bismillah -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="☪ ﷽ ☪"
            android:textColor="#FDE047"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_prayer_hijri_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="۲۹ صفر ۱۴۴۸ ھ"
            android:textColor="#FDE047"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main LED Clock Acrylic Display Panel (matching Mosque Wall Clock from image) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_led_window"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp">

        <!-- Glowing Red 7-Segment Digital Clock -->
        <TextClock
            android:id="@+id/tc_prayer_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:shadowColor="#E6FF0000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:textColor="#FF2A2A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/tc_prayer_ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:includeFontPadding="false"
                    android:textColor="#F87171"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_prayer_next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="· اگلی نماز: العصر"
                    android:textColor="#34D399"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextClock
                android:id="@+id/tc_prayer_gregorian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:format12Hour="yyyy-MM-dd · EEEE"
                android:format24Hour="yyyy-MM-dd · EEEE"
                android:includeFontPadding="false"
                android:textColor="#94A3B8"
                android:textSize="9.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_prayer_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_led_window_active"
            android:includeFontPadding="false"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:shadowColor="#E6FF0000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"
            android:text="04:40 PM"
            android:textColor="#FEF08A"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 6 Mosque Azan LED Time Compartments (Fajr, Sunrise, Dhuhr, Asr, Maghrib, Isha) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="6">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/ll_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_led_window"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#E2E8F0"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_fajr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:shadowColor="#99FF0000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="4"
                android:text="04:30"
                android:textColor="#F87171"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAJR"
                android:textColor="#64748B"
                android:textSize="7sp" />
        </LinearLayout>

        <!-- Sunrise / Shuruq -->
        <LinearLayout
            android:id="@+id/ll_sunrise"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_led_window"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الشروق"
                android:textColor="#FDE047"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sunrise_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:shadowColor="#99FBBF24"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="4"
                android:text="05:50"
                android:textColor="#FBBF24"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHURUQ"
                android:textColor="#78716C"
                android:textSize="7sp" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/ll_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_led_window"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#E2E8F0"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dhuhr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:shadowColor="#99FF0000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="4"
                android:text="12:12"
                android:textColor="#F87171"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZUHR"
                android:textColor="#64748B"
                android:textSize="7sp" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/ll_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_led_window"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="#E2E8F0"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_asr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:shadowColor="#99FF0000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="4"
                android:text="04:40"
                android:textColor="#F87171"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASR"
                android:textColor="#64748B"
                android:textSize="7sp" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/ll_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_led_window"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="#E2E8F0"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_maghrib_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:shadowColor="#99FF0000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="4"
                android:text="06:27"
                android:textColor="#F87171"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAGHRIB"
                android:textColor="#64748B"
                android:textSize="7sp" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/ll_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_led_window"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="#E2E8F0"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_isha_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:shadowColor="#99FF0000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="4"
                android:text="07:52"
                android:textColor="#F87171"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ISHA"
                android:textColor="#64748B"
                android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
